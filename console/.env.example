# No map token needed. The basemap is CARTO dark-matter via MapLibre GL — keyless.

# The one shared passphrase unlocking /add and /review, entered once per device.
# Rotating it invalidates every device's unlock cookie at once.
SHARED_PASSPHRASE=pick-something-memorable

# The paid extraction/transcription key. Held only by the Gate-1 spawns.
ANTHROPIC_API_KEY=sk-ant-...
